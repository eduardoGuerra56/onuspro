extends layouts/login-layout.pug

block content 
    .loginContainer 
        a.userImageContainerLogin
            img(src='images/bannerRegistro.png')  
        form#registerForm(method="post", onsubmit="event.preventDefault(); validateForm();")

            p.errorMessage #{errorMessage}

            input(type="text", name="firstName", placeholder="Primeiro nome", value = firstName  required="")
            input(type="text", name="lastName", placeholder="Ultimo nome", value = lastName required="")
            input(type="text", name="username", placeholder="Usuario", value = username required="")
            input(type="email", name="email", placeholder="Email", value = email required="")
            input#password(type="password", name="password", placeholder="Senha", required="")
            input#passwordConf(type="password", name="passwordConf", placeholder="Confirme sua senha", required="")
            input(type="submit", value="REGISTRAR-SE")

        a(href="/login") Se já tem uma conta, clique aqui!

    script.
        var passwordField = document.getElementById("password");
        var passwordConfirmField = document.getElementById("passwordConf");
        var form = document.getElementById("registerForm");

        function validateForm(){
            if(passwordField.value != passwordConfirmField.value) {
                alert("Senha diferente, por favor digite novamente!");
            }
            else{
                form.submit();  
            }
        }