extends layouts/login-layout.pug

block content 
    .loginContainer 
        a.userImageContainerLogin
            img(src='images/bannerLogin.png')        
        form(method="post")
            p.errorMessage #{errorMessage}
            input(type="text", name="logUsername", placeholder="Usuario", value = logUsername required="")
            input(type="password", name="logPassword", placeholder="Senha", required="")
            input(type="submit", value="ENTRAR")
        a(href="/register") Precisa de conta? Clique aqui!